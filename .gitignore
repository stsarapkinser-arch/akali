# Generated state / caches
vector_cache.json
auto_commands.json
query_cache.json
*.embedcache.pkl
*.embedcache.tmp

# Python
__pycache__/
*.pyc
*.pyo

# Vosk speech-recognition model (88+ MB) — downloaded by setup.sh
model/

# Voices: piper .onnx + XTTS jarvis reference wav (загружается пользователем,
# не лежит в git — это «private» голос для voice cloning).
voices/*.onnx
voices/*.onnx.json
voices/jarvis_reference.wav
voices/jarvis_reference.*

# TTS audio cache (~/.cache/akali/tts) — генерируется при первом запуске,
# зависит от движка и системы.
*.wav.part

# Временный install-скрипт Ollama (скачивается system_check автоматически).
.ollama-install.sh

# Local secrets
.env
.env.*

# OS / Editor
.DS_Store
.idea/
.vscode/
*.swp
