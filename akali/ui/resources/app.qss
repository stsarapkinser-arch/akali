/* ============================================================
   Akali — Cyber Arc тёмная тема. Окно 420×720.
   ============================================================ */

/* === Базовые виджеты === */
QWidget#centralBg {
    background-color: #050911;
    color: #d8e4ee;
    font-family: "Inter", "Segoe UI", "Noto Sans", "DejaVu Sans", sans-serif;
}
QMainWindow, QDialog {
    background-color: #050911;
    color: #d8e4ee;
    font-family: "Inter", "Segoe UI", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 12px;
}
QWidget {
    color: #d8e4ee;
    font-family: "Inter", "Segoe UI", "Noto Sans", "DejaVu Sans", sans-serif;
}

/* === Header === */
QFrame#headerBar {
    background-color: #07101c;
    border-bottom: 1px solid rgba(0, 212, 255, 0.18);
    min-height: 56px;
    max-height: 56px;
}

/* === Nav-кнопки (вкладки) === */
QPushButton#tabButton {
    background: transparent;
    color: #5a7896;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 4px 6px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    font-family: "JetBrains Mono", "Fira Code", monospace;
}
QPushButton#tabButton:hover {
    color: #a0c8e0;
    background: rgba(0, 212, 255, 0.05);
    border-radius: 3px;
}
QPushButton#tabButton:checked {
    color: #00d4ff;
    border-bottom: 2px solid #00d4ff;
    background: rgba(0, 212, 255, 0.07);
}

/* === Кнопки управления окном (—, ✕) === */
QPushButton#windowCtrlBtn {
    background: transparent;
    color: #4a6070;
    border: none;
    border-radius: 3px;
    font-size: 13px;
    font-weight: 400;
    padding: 2px 6px;
    min-width: 24px;
    max-width: 32px;
    min-height: 20px;
}
QPushButton#windowCtrlBtn:hover {
    color: #cde8f8;
    background: rgba(0, 212, 255, 0.10);
}
QPushButton#windowCtrlBtn[close="true"]:hover {
    color: #ff7878;
    background: rgba(255, 90, 90, 0.15);
}

/* === Разделители === */
QFrame#topSeparator, QFrame#bottomSeparator {
    color: #0e1e30;
    background: #0e1e30;
    max-height: 1px;
    min-height: 1px;
}
QFrame#homeSeparator {
    color: rgba(0, 212, 255, 0.10);
    background: rgba(0, 212, 255, 0.10);
    max-height: 1px;
    min-height: 1px;
}

/* === Stack страниц === */
QStackedWidget#pageStack {
    background-color: #050911;
}

/* === Заголовки страниц === */
QLabel#pageTitle {
    color: #e6f7ff;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 3px;
    font-family: "JetBrains Mono", monospace;
}
QLabel#pageSubtitle {
    color: #5a7896;
    font-size: 10px;
    margin-bottom: 2px;
}
QLabel#sectionLabel {
    color: #2a6a8a;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 3px;
    font-family: "JetBrains Mono", monospace;
}
QLabel#formLabel {
    color: #7a96b2;
    font-size: 11px;
}

/* === HomePage — branding === */
QLabel#homeBrand {
    color: #1a4a6a;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 4px;
    font-family: "JetBrains Mono", "Fira Code", monospace;
}

/* === HomePage — большой статус === */
QLabel#bigStatus {
    color: #00dcff;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 6px;
    font-family: "JetBrains Mono", monospace;
    padding: 2px 0;
}
QLabel#hint {
    color: #3a6080;
    font-size: 11px;
    letter-spacing: 0.5px;
}

/* === Spoken / partial text === */
QLabel#spokenText {
    color: #4aa0c8;
    font-size: 12px;
    font-style: italic;
}
QLabel#spokenText[partial="true"] {
    color: #2a5870;
    font-size: 12px;
    font-style: italic;
}

/* === Confidence bar label === */
QLabel#confidenceLabel {
    color: #4a8aaa;
    font-size: 10px;
    letter-spacing: 1px;
    font-family: "JetBrains Mono", monospace;
}
QLabel#confidenceMethod {
    color: #2a6080;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2px;
    font-family: "JetBrains Mono", monospace;
}

/* === LLM Panel === */
QFrame#llmPanel {
    background-color: rgba(5, 15, 28, 0.90);
    border: 1px solid rgba(0, 212, 255, 0.20);
    border-top: 2px solid rgba(0, 212, 255, 0.40);
    border-radius: 6px;
    padding: 2px;
}
QLabel#llmTitle {
    color: #00d4ff;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 3px;
    font-family: "JetBrains Mono", monospace;
}
QLabel#llmText {
    color: #8ac0e0;
    font-size: 11px;
}

/* === Toast overlay === */
QLabel#toastFrame {
    background-color: rgba(0, 16, 30, 0.94);
    border: 1px solid rgba(0, 212, 255, 0.35);
    border-radius: 14px;
    color: #00d4ff;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 8px 20px;
    font-family: "JetBrains Mono", monospace;
}

/* === Settings gear button on HomePage === */
QPushButton#settingsGearBtn {
    background: transparent;
    border: none;
    padding: 4px;
    border-radius: 4px;
}
QPushButton#settingsGearBtn:hover {
    background-color: rgba(0, 212, 255, 0.12);
}

/* === Back button on SettingsPage === */
QPushButton#backBtn {
    background: transparent;
    color: #00d4ff;
    border: 1px solid rgba(0, 212, 255, 0.30);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 4px 12px;
    font-family: "JetBrains Mono", monospace;
}
QPushButton#backBtn:hover {
    background-color: rgba(0, 212, 255, 0.12);
    border-color: rgba(0, 212, 255, 0.55);
}

/* === Кнопки === */
QPushButton#primaryBtn {
    background-color: rgba(0, 212, 255, 0.10);
    color: #00d4ff;
    border: 1px solid rgba(0, 212, 255, 0.55);
    padding: 8px 22px;
    border-radius: 4px;
    font-weight: 700;
    letter-spacing: 3px;
    font-size: 11px;
    font-family: "JetBrains Mono", monospace;
}
QPushButton#primaryBtn:hover {
    background-color: rgba(0, 212, 255, 0.20);
    border-color: #00d4ff;
    color: #5be8ff;
}
QPushButton#primaryBtn:pressed {
    background-color: rgba(0, 212, 255, 0.35);
}
QPushButton#primaryBtn[danger="true"] {
    background-color: rgba(255, 90, 90, 0.12);
    color: #ff7878;
    border: 1px solid rgba(255, 90, 90, 0.55);
}
QPushButton#primaryBtn[danger="true"]:hover {
    background-color: rgba(255, 90, 90, 0.25);
    color: #ffa6a6;
}

QPushButton#secondaryBtn {
    background-color: transparent;
    color: #4a6a86;
    border: 1px solid #152030;
    padding: 6px 14px;
    border-radius: 4px;
    letter-spacing: 2px;
    font-weight: 600;
    font-size: 10px;
    font-family: "JetBrains Mono", monospace;
}
QPushButton#secondaryBtn:hover {
    color: #a0c8e0;
    border-color: #1e4060;
    background-color: rgba(0, 212, 255, 0.04);
}
QPushButton#secondaryBtn:pressed {
    background-color: rgba(0, 212, 255, 0.08);
}

/* === Кнопка копирования (⎘) === */
QPushButton#copyBtn {
    background: transparent;
    color: #2a5070;
    border: none;
    border-radius: 3px;
    font-size: 14px;
    padding: 0px 4px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
}
QPushButton#copyBtn:hover {
    color: #00d4ff;
    background: rgba(0, 212, 255, 0.08);
}

/* === Кнопка запуска команды (▶) === */
QPushButton#runBtn {
    background: transparent;
    color: #1a4060;
    border: none;
    border-radius: 3px;
    font-size: 12px;
    padding: 0px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
}
QPushButton#runBtn:hover {
    color: #00d4ff;
    background: rgba(0, 212, 255, 0.10);
}
QPushButton#runBtn:pressed {
    color: #5be8ff;
    background: rgba(0, 212, 255, 0.20);
}

/* === Кнопка удаления (✕) — красная подсветка === */
QPushButton#dangerBtn {
    background: transparent;
    color: #c54a4a;
    border: none;
    border-radius: 3px;
    font-size: 12px;
    padding: 0px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
}
QPushButton#dangerBtn:hover {
    color: #ff6b6b;
    background: rgba(255, 80, 80, 0.10);
}
QPushButton#dangerBtn:pressed {
    color: #ff8a8a;
    background: rgba(255, 80, 80, 0.20);
}

/* === Пилюли категорий === */
QPushButton#categoryPill {
    background: transparent;
    color: #3a5a76;
    border: 1px solid #0e1e30;
    border-radius: 11px;
    padding: 2px 10px;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1px;
    font-family: "JetBrains Mono", monospace;
    min-height: 22px;
    max-height: 22px;
}
QPushButton#categoryPill:hover {
    color: #8abcd8;
    border-color: #1e4060;
    background: rgba(0, 212, 255, 0.04);
}
QPushButton#categoryPill:checked {
    color: #00d4ff;
    border-color: rgba(0, 212, 255, 0.55);
    background: rgba(0, 212, 255, 0.10);
}

/* === Общий QPushButton (не именованный) === */
QPushButton {
    background-color: #0b1826;
    color: #c0d8ee;
    border: 1px solid #162840;
    padding: 6px 14px;
    border-radius: 4px;
    font-weight: 500;
    font-size: 12px;
}
QPushButton:hover {
    background-color: #102036;
    border-color: #1e4060;
}
QPushButton:pressed {
    background-color: #080f1a;
}
QPushButton:disabled {
    color: #253040;
    background-color: #080f1a;
    border-color: #0e1e2e;
}

/* === Status row (нижняя строка) === */
QWidget#statusRow {
    background-color: rgba(7, 16, 28, 0.90);
    border-top: 1px solid rgba(0, 212, 255, 0.10);
}
QLabel#chipSubtitle {
    color: #4a7080;
    font-size: 10px;
    letter-spacing: 0.3px;
}
QLabel#chipTitle {
    color: #7a96b2;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    font-family: "JetBrains Mono", monospace;
}

/* === Inputs === */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit, QListWidget {
    background-color: #080f1a;
    border: 1px solid #162840;
    border-radius: 4px;
    padding: 5px 8px;
    color: #c0d8ee;
    font-size: 12px;
    selection-background-color: #00d4ff;
    selection-color: #001823;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid rgba(0, 212, 255, 0.60);
}
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #2a7090;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #080f1a;
    border: 1px solid #162840;
    selection-background-color: rgba(0, 212, 255, 0.25);
    color: #c0d8ee;
    outline: 0;
}

/* === Карточки команд === */
QFrame#commandCard {
    background-color: rgba(8, 15, 26, 0.75);
    border: 1px solid rgba(0, 212, 255, 0.08);
    border-radius: 6px;
    border-left: 3px solid rgba(0, 212, 255, 0.15);
}
QFrame#commandCard:hover {
    border: 1px solid rgba(0, 212, 255, 0.22);
    border-left: 3px solid rgba(0, 212, 255, 0.55);
    background-color: rgba(10, 20, 36, 0.85);
}
/* Цвета левой полоски по категории */
QFrame#commandCard[category="рабочий стол"] { border-left: 3px solid rgba(120, 160, 255, 0.55); }
QFrame#commandCard[category="браузер"]       { border-left: 3px solid rgba(80, 200, 180, 0.55); }
QFrame#commandCard[category="аудио"]        { border-left: 3px solid rgba(255, 160, 60, 0.55); }
QFrame#commandCard[category="сеть"]          { border-left: 3px solid rgba(60, 200, 120, 0.55); }
QFrame#commandCard[category="питание"]       { border-left: 3px solid rgba(255, 90, 90, 0.55); }
QFrame#commandCard[category="файлы"]        { border-left: 3px solid rgba(200, 180, 100, 0.55); }
QFrame#commandCard[category="мониторинг"]    { border-left: 3px solid rgba(180, 100, 255, 0.55); }
QFrame#commandCard[category="система"]       { border-left: 3px solid rgba(100, 180, 255, 0.55); }

QLabel#cardCmd {
    color: #00d4ff;
    font-family: "JetBrains Mono", "Fira Code", "DejaVu Sans Mono", monospace;
    font-size: 11px;
    font-weight: 600;
}
QLabel#cardTriggers {
    color: #3a5a76;
    font-size: 10px;
}

/* === Карточки настроек === */
QFrame#settingsCard {
    background-color: rgba(8, 15, 26, 0.75);
    border: 1px solid rgba(0, 212, 255, 0.08);
    border-radius: 6px;
}

/* === Скроллы без рамки === */
QScrollArea#cardScroll, QScrollArea#settingsScroll, QScrollArea#categoryScroll {
    background: transparent;
    border: none;
}
QScrollArea#cardScroll > QWidget > QWidget,
QScrollArea#settingsScroll > QWidget > QWidget,
QScrollArea#categoryScroll > QWidget > QWidget {
    background: transparent;
}
QWidget#cardList, QWidget#settingsHost, QWidget#categoryBar {
    background: transparent;
}

/* === Лог QPlainTextEdit === */
QPlainTextEdit#logView {
    font-family: "JetBrains Mono", "Fira Code", "DejaVu Sans Mono", monospace;
    font-size: 11px;
    color: #8abcd8;
    background-color: #040810;
    border: 1px solid #0e1e30;
}

/* === Tooltips === */
QToolTip {
    background-color: #0b1826;
    color: #a0c8e0;
    border: 1px solid #162840;
    border-radius: 4px;
    padding: 5px 7px;
    font-size: 11px;
}

/* === Scrollbars === */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #162840;
    min-height: 30px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover { background: #1e4060; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #162840;
    min-width: 30px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover { background: #1e4060; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* === Слайдер (energy threshold) === */
QSlider::groove:horizontal {
    background: #0e1e30;
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #00d4ff;
    border: 1px solid rgba(0, 212, 255, 0.6);
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal {
    background: rgba(0, 212, 255, 0.40);
    border-radius: 2px;
}

/* === Progress bar (update) === */
QProgressBar#updateProgress {
    background-color: #0e1e30;
    border: none;
    border-radius: 3px;
}
QProgressBar#updateProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #00D4FF, stop:1 #1D8EE6);
    border-radius: 3px;
}
