/* Akali — Premium Dark Theme with Cyber Aesthetics
   Color Palette: Deep Dark #0D1117 + Cyber Cyan #00D4FF + Neon Blue #1D8EE6 + Accent #00FFFF
*/

* {
    font-family: "JetBrains Mono", "Courier New", monospace;
    color: #E6EDF3;
}

QMainWindow {
    background-color: #0D1117;
    border: none;
}

/* ──────────────────────────────────────── Central Widget */
QWidget#centralBg {
    background-color: #0D1117;
    margin: 0px;
    padding: 0px;
}

/* ──────────────────────────────────────── Header Bar */
QFrame#headerBar {
    background-color: #0D1117;
    border-bottom: 2px solid #00D4FF;
    padding: 12px 16px;
    margin: 0px;
}

QLabel#headerLogo {
    color: #00FFFF;
    font-weight: bold;
    font-size: 16px;
    margin: 0px 8px;
    letter-spacing: 2px;
}

QLabel#headerVersion {
    color: #00D4FF;
    font-size: 9px;
    margin: 0px;
    font-weight: bold;
}

/* ──────────────────────────────────────── Tab Buttons */
QPushButton#tabButton {
    background-color: transparent;
    border: none;
    color: #8B949E;
    padding: 8px 12px;
    margin: 0px 4px;
    font-size: 11px;
    border-radius: 4px;
    font-weight: bold;
    letter-spacing: 1px;
}

QPushButton#tabButton:hover {
    background-color: rgba(0, 212, 255, 0.1);
    color: #00FFFF;
    border-radius: 4px;
}

QPushButton#tabButton:pressed,
QPushButton#tabButton.active {
    background-color: transparent;
    color: #00FFFF;
    border-bottom: 3px solid #00FFFF;
    padding-bottom: 5px;
    font-weight: bold;
}

/* ──────────────────────────────────────── Page Stack */
QStackedWidget#pageStack {
    background-color: #0D1117;
    margin: 0px;
    padding: 0px;
}

/* ──────────────────────────────────────── Status Row / Footer */
QFrame#statusRow {
    background-color: #0D1117;
    border-top: 2px solid #00D4FF;
    padding: 12px 16px;
    margin: 0px;
}

QLabel#statusLabel {
    color: #8B949E;
    font-size: 10px;
    padding: 2px 4px;
    font-weight: bold;
}

QLabel#statusValue {
    color: #00FFFF;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#statusLED {
    border-radius: 50%;
    width: 10px;
    height: 10px;
    margin: 0px 4px;
}

QLabel#ledGreen {
    background-color: #3FB950;
    box-shadow: 0px 0px 8px rgba(63, 185, 80, 0.6);
}

QLabel#ledYellow {
    background-color: #D29922;
    box-shadow: 0px 0px 8px rgba(210, 153, 34, 0.6);
}

QLabel#ledRed {
    background-color: #F85149;
    box-shadow: 0px 0px 8px rgba(248, 81, 73, 0.6);
}

/* ──────────────────────────────────────── Separators */
QFrame#topSeparator,
QFrame#bottomSeparator {
    background-color: #30363D;
    max-height: 1px;
    margin: 0px;
    padding: 0px;
}

/* ──────────────────────────────────────── Buttons */
QPushButton#primaryButton {
    background-color: #1D8EE6;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 12px 24px;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}

QPushButton#primaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #2591F0, stop:1 #1D8EE6);
    box-shadow: 0px 4px 16px rgba(29, 142, 230, 0.5);
}

QPushButton#primaryButton:pressed {
    background-color: #1564B5;
    box-shadow: 0px 2px 8px rgba(29, 142, 230, 0.3);
}

QPushButton#secondaryButton {
    background-color: #161B22;
    color: #00FFFF;
    border: 2px solid #00D4FF;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}

QPushButton#secondaryButton:hover {
    background-color: rgba(0, 212, 255, 0.1);
    border-color: #00FFFF;
    color: #00FFFF;
    box-shadow: 0px 0px 12px rgba(0, 255, 255, 0.3);
}

QPushButton#secondaryButton:pressed {
    background-color: rgba(0, 212, 255, 0.2);
    box-shadow: 0px 0px 8px rgba(0, 212, 255, 0.2);
}

/* ──────────────────────────────────────── Cards */
QFrame#card {
    background-color: rgba(22, 27, 34, 0.5);
    border: 1px solid #30363D;
    border-radius: 8px;
    padding: 16px;
    margin: 8px 0px;
}

QFrame#card:hover {
    border: 2px solid #00D4FF;
    background-color: rgba(22, 27, 34, 0.8);
    box-shadow: 0px 4px 16px rgba(0, 212, 255, 0.15);
}

QLabel#cardTitle {
    color: #00FFFF;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

QLabel#cardDescription {
    color: #8B949E;
    font-size: 11px;
    margin: 0px;
}

/* ──────────────────────────────────────── Input Fields */
QLineEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #161B22;
    color: #E6EDF3;
    border: 2px solid #30363D;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 11px;
    selection-background-color: #1D8EE6;
}

QLineEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 2px solid #00D4FF;
    background-color: #0F1419;
    box-shadow: 0px 0px 12px rgba(0, 212, 255, 0.25);
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
    background-color: #161B22;
}

QComboBox::down-arrow {
    image: none;
    width: 12px;
    height: 12px;
}

/* ──────────────────────────────────────── Checkboxes & Radio */
QCheckBox,
QRadioButton {
    color: #E6EDF3;
    spacing: 8px;
    margin: 2px;
    font-weight: bold;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 3px;
    border: 2px solid #30363D;
    background-color: #0D1117;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #00D4FF;
    background-color: #161B22;
    box-shadow: 0px 0px 8px rgba(0, 212, 255, 0.2);
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #1D8EE6;
    border-color: #00FFFF;
}

QCheckBox::indicator:checked::after {
    image: none;
}

/* ──────────────────────────────────────── Sliders */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background-color: #30363D;
    border-radius: 3px;
    margin: 0px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                               stop:0 #00D4FF, stop:1 #1D8EE6);
    border: none;
    width: 16px;
    height: 16px;
    margin: -5px 0px;
    border-radius: 8px;
    box-shadow: 0px 0px 8px rgba(0, 212, 255, 0.4);
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                               stop:0 #00FFFF, stop:1 #2591F0);
    box-shadow: 0px 0px 12px rgba(0, 255, 255, 0.5);
}

/* ──────────────────────────────────────── Scrollbars */
QScrollBar:vertical {
    background-color: #0D1117;
    width: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #30363D;
    border-radius: 4px;
    min-height: 20px;
    margin: 0px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00D4FF;
    box-shadow: 0px 0px 8px rgba(0, 212, 255, 0.3);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #0D1117;
    height: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #30363D;
    border-radius: 4px;
    min-width: 20px;
    margin: 0px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #00D4FF;
    box-shadow: 0px 0px 8px rgba(0, 212, 255, 0.3);
}

/* ──────────────────────────────────────── Tables */
QTableWidget,
QTableView,
QListWidget {
    background-color: #0D1117;
    alternate-background-color: #161B22;
    gridline-color: #30363D;
    border: 1px solid #30363D;
    border-radius: 4px;
}

QHeaderView::section {
    background-color: #161B22;
    color: #E6EDF3;
    padding: 6px;
    border: none;
    border-right: 1px solid #30363D;
    border-bottom: 2px solid #00D4FF;
    font-weight: bold;
}

QTableWidget::item,
QListWidget::item {
    padding: 4px;
}

QTableWidget::item:selected,
QListWidget::item:selected {
    background-color: #1D8EE6;
    color: #FFFFFF;
}

QTableWidget::item:hover,
QListWidget::item:hover {
    background-color: rgba(0, 212, 255, 0.1);
}

/* ──────────────────────────────────────── Tooltips */
QToolTip {
    background-color: #161B22;
    color: #E6EDF3;
    border: 2px solid #00D4FF;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 10px;
    font-weight: bold;
}

/* ──────────────────────────────────────── Message Boxes */
QMessageBox {
    background-color: #0D1117;
}

QMessageBox QLabel {
    color: #E6EDF3;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* ──────────────────────────────────────── Status Label */
QLabel#reactorStatus {
    color: #00FFFF;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#infoPanel {
    background-color: rgba(22, 27, 34, 0.3);
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 12px;
}
